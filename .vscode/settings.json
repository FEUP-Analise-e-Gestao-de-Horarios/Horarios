{
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cSpell.words": [
    "appuser",
    "ASGI",
    "astral",
    "cabtitulo",
    "collectstatic",
    "csrftoken",
    "docstrings",
    "executescript",
    "Feup",
    "ingestors",
    "isort",
    "lastrowid",
    "livereload",
    "matplotlib",
    "mypy",
    "networkx",
    "noinput",
    "outerjoin",
    "overscan",
    "popleft",
    "pycache",
    "pycodestyle",
    "pydantic",
    "pyenv",
    "pyflakes",
    "pypi",
    "pyproject",
    "PYTHONPATH",
    "pyupgrade",
    "readerwriterlock",
    "rowspan",
    "runserver",
    "selectinload",
    "simplifiable",
    "sqlalchemy",
    "staticfiles",
    "uvx",
    "venv",
    "Vite",
    "whitenoise"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "eslint.enable": true,
  "eslint.format.enable": false,
  "eslint.run": "onType",
  "eslint.useESLintClass": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": ["frontend"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/venv": true
  },
  "js/ts.tsdk.path": "frontend/node_modules/typescript/lib",
  "python-envs.defaultEnvManager": "ms-python.python:venv"
}
